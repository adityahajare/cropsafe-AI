PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/crop_insurance
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

OPENWEATHER_API_KEY=your_openweather_key
WEATHER_API_KEY=your_openweather_key

SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_client_secret

PLANTNET_API_KEY=your_plantnet_key
OPENAI_API_KEY=your_openai_key_if_used
GEOAPIFY_API_KEY=your_geoapify_key

ENABLE_OPENAI_ASSISTANT=false
ENABLE_OPENAI_DISEASE_VISION=false

ADMIN_EMAIL=admin@cropsafe.com
ADMIN_PASSWORD=change_this_password
NODE_ENV=development
